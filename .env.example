# Copy to .dev.vars for local development (wrangler dev reads that file).
# Never commit the filled-in copy. Values are server-side only.

# Qloo hackathon API key (required).
QLOO_API_KEY=

# Optional. When set, the Anthropic API is used instead of Workers AI.
ANTHROPIC_API_KEY=

# Optional. Per-visitor rate limits on the POST /api routes (see docs/API.md,
# "Limits"). The defaults are 60 and 20 requests per 600 seconds. A value of 0
# turns that limit off, which is handy when testing locally.
# RATE_LIMIT_GENERAL=60
# RATE_LIMIT_HEAVY=20
# RATE_LIMIT_WINDOW_SECONDS=600
