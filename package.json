{
  "name": "rung",
  "version": "0.1.0",
  "private": true,
  "description": "Rung: an agent that turns what a reluctant reader already loves into a short ladder of books they might finish. A Cloudflare Worker for the Qloo Agentic Hackathon.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "dev:local": "wrangler dev -c wrangler.local.jsonc",
    "fake-qloo": "node scripts/fake-qloo.mjs",
    "dev:fake": "wrangler dev -c wrangler.local.jsonc --var QLOO_API_KEY:local-stand-in --var QLOO_BASE_URL:http://127.0.0.1:8799",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261008.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  }
}
